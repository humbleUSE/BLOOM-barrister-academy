{
    "importOrder": [
        "<BUILTIN_MODULES>",
        "<THIRD_PARTY_MODULES>",
        "^@/components/(.*)$",
        "^@/hooks/(.*)$",
        "^[./]"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true,
    "tabWidth": 4,
    "tailwindAttributes": ["myClassList", "/data-.*/"],
    "tailwindFunctions": ["clsx", "cva"],
    "tailwindStylesheet": "./src/styles/index.css",
    "useTabs": false
}
